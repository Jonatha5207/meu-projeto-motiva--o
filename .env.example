PORT=8000
ADMIN_TOKEN=troque-este-token
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_REALTIME_MODEL=gpt-realtime
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@companheiro.app
# Opcional: sem isso, o app roda em modo memória (dev), salvando em .data/companheiro.json.
# Com uma connection string do Supabase/Postgres aqui, ele usa o banco de verdade.
DATABASE_URL=
# Defina como "false" para Postgres local sem SSL (ex.: docker-compose). O Supabase
# exige SSL, então deixe em branco (equivale a "true") ao apontar para ele.
DATABASE_SSL=
NODE_ENV=development
